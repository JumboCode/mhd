# Postgres connection string. Auto-set by Vercel when Neon integration is added.
DATABASE_URL=

# Random secret for better-auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of your deployment (e.g. https://mhd.vercel.app or https://mhd.org).
# After first deploy, copy your Vercel URL here and redeploy.
BETTER_AUTH_URL=

# Resend API key. Get from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address in your Resend account (e.g. noreply@yourdomain.org).
# The domain must be verified in Resend before emails will send.
EMAIL_FROM=
